APP_RUNTIME=production
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=/var/lib/daily-plan/daily_plan.db
DAILY_PLAN_BACKUP_DIR=/var/backups/daily-plan
DAILY_PLAN_BACKUP_RETENTION_DAYS=14
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=20
# 手机到点提醒：全部配置后才启用；凭据仅存在服务器环境文件。
# URL填ntfy服务根地址；主题须有访问控制，TOKEN需要该主题发布权限。
DAILY_PLAN_NTFY_URL=
DAILY_PLAN_NTFY_TOPIC=
DAILY_PLAN_NTFY_TOKEN=
# 点手机通知返回的正式网页根地址，例如现有HTTPS入口。
DAILY_PLAN_PUBLIC_URL=
